# Скопируйте этот файл в .env.local и заполните реальными значениями.
# .env.local никогда не должен попадать в git (см. .gitignore).

# Токен доступа сообщества/пользователя VK с правом messages.
# Получить можно, например, через VK ID / Standalone-приложение
# с правами (scope) "messages", или ключ сообщества с правом "Сообщения".
VK_ACCESS_TOKEN=

# ID диалога/получателя в VK, куда слать сообщение.
# Для личного аккаунта — это его user_id.
# Для сообщения от имени сообщества в диалог с пользователем —
# peer_id обычно равен user_id получателя.
VK_PEER_ID=

# Версия VK API (необязательно, по умолчанию 5.199)
VK_API_VERSION=5.199
